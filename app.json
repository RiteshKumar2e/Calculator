      "package": "com.calculator.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "title": "Calculator"
    },
    "plugins": [],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "2972e02b-99cf-47c9-afc2-1f61d910a7ae"
      }
    }
  }
